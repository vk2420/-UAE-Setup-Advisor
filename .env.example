# Copy to .env and fill in. NEVER commit your real .env (it is gitignored).

# --- LLM explanation layer (OPTIONAL) ---
# Without a key, the app still works: it serves a deterministic, fully-cited
# explanation built from the engine's own output. Set a key to get a friendly,
# LLM-written narrative instead. The LLM only explains; it never decides.
ANTHROPIC_API_KEY=
# Model used for the explanation (only when a key is set).
ANTHROPIC_MODEL=claude-opus-5

# --- API server ---
# Comma-separated extra CORS origins (the local Vite dev server is allowed by default).
CORS_ORIGINS=

# --- Frontend ---
# Base URL the React app uses to reach the API (used at build time by Vite).
VITE_API_BASE_URL=http://localhost:8000
